# Server
PORT=5000
NODE_ENV=production

# Database (MySQL) - fill in with your provider's connection details
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=eduflow

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS / Socket.IO — only needed if client and server are on different
# domains. Leave empty when served from the same Docker image/origin.
FRONTEND_URL=

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=104857600
